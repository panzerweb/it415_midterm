    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.10"
  }
